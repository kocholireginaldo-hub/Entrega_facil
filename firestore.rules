rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function admin() { return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Só o console do Firebase cria documentos aqui. O app apenas lê o próprio.
    match /admins/{uid} { allow read: if logado() && request.auth.uid == uid; allow write: if false; }

    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || admin());
      allow create: if logado() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == 'employee';
      allow update: if logado() && request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.uid == uid;
      allow delete: if false;
    }

    match /deliveries/{id} {
      allow read: if logado() && (resource.data.userId == request.auth.uid || admin());
      allow create: if logado() && request.resource.data.userId == request.auth.uid
        && request.resource.data.deliveryType in ['standard', 'special']
        && request.resource.data.photoPath == 'deliveries/' + request.auth.uid + '/' + id + '/photo.jpg'
        && request.resource.data.createdAt == request.time;
      allow update: if false;   // registros imutáveis
      allow delete: if logado() && (resource.data.userId == request.auth.uid || admin());
    }
  }
}
