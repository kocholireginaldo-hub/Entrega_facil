rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
    match /deliveries/{uid}/{id}/{arquivo} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if request.auth != null && request.auth.uid == uid && arquivo == 'photo.jpg'
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow update: if false;
      allow delete: if request.auth != null && (request.auth.uid == uid || admin());
    }
  }
}
